# Salin ke .env dan jangan commit file .env.
NODE_ENV=development
PORT=3000

# URL/proxy keamanan. Production wajib HTTPS.
TDRIVE_HTTPS=false
# Jumlah reverse proxy tepercaya (contoh: 1 untuk Nginx lokal di depan aplikasi).
TRUST_PROXY=false

# Secret express-session minimal 32 karakter acak pada production.
SESSION_SECRET=
SESSION_MAX_AGE_MS=2592000000
SESSION_SAME_SITE=lax

# Kunci AES-256-GCM tepat 64 karakter hex. Generate: npm run genkey
TDRIVE_MASTER_KEY=
# Opsional: pisahkan kunci backup dari master key aplikasi (direkomendasikan).
BACKUP_ENCRYPTION_KEY=

# MariaDB. Production: gunakan user khusus berhak minimum, bukan root.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=tdrive_app
DB_PASSWORD=
DB_DATABASE=tdrive
DB_CONNECTION_LIMIT=10

# Daftar nomor admin/login yang diizinkan, dipisahkan koma.
TDRIVE_ALLOWED_PHONES=+628123456789

# Batas request dan autentikasi.
TDRIVE_GLOBAL_LIMIT=150
TDRIVE_AUTH_LIMIT=15
WEBDAV_AUTH_LIMIT=10
WEBDAV_MAX_BODY_BYTES=65536

# Upload Telegram.
TDRIVE_CHUNK_MB=1900
TDRIVE_MAX_UPLOAD_MB=10240

# Backup database terenkripsi.
# Windows: folder yang berisi mariadb-dump.exe atau mysqldump.exe.
MARIADB_BIN_PATH=C:\wamp64\bin\mariadb\mariadb11.5.2\bin
BACKUP_DIR=./data/backups
BACKUP_SCHEDULE_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
# Opsional: direktori/volume kedua. Artifact terenkripsi disalin lalu checksum diverifikasi.
BACKUP_SECONDARY_DIR=
# Berbahaya: tetap false kecuali saat maintenance restore terencana.
BACKUP_RESTORE_ENABLED=false

# Durable MariaDB job worker.
JOB_WORKER_ENABLED=true
JOB_POLL_MS=2000
JOB_LEASE_MS=900000

# Rekonsiliasi membatasi jumlah file dan menandai upload receiving yang terlalu lama.
RECONCILIATION_MAX_FILES=100
UPLOAD_STALE_MINUTES=60

# Dashboard storage dan Telegram health.
# 0 menonaktifkan soft quota; contoh 1099511627776 = 1 TiB.
STORAGE_QUOTA_BYTES=0
STORAGE_QUOTA_WARN_PERCENT=85
