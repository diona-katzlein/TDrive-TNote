<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#f8fafc" />
  <title><%= typeof title !== 'undefined' ? title : 'TDrive & TNote' %> · TDrive</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script>
    (function () {
      try {
        var saved = localStorage.getItem('tdriveTheme');
        var theme = saved === 'light' || saved === 'dark'
          ? saved
          : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      } catch (_) {}
    })();
  </script>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="auth-body">
  <header class="topbar auth-topbar">
    <a class="brand" href="/login" aria-label="TDrive login"><img src="/logo.svg" alt="TDrive Logo" /></a>
    <button class="icon-btn theme-toggle" type="button" aria-label="Ganti tema" title="Ganti tema">
      <span class="theme-icon" aria-hidden="true">◐</span>
    </button>
  </header>
  <main class="container auth-container">
