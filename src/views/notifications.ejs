<%- include('partials/header') %>
<div class="page-head"><div><div class="breadcrumb">Notifikasi</div><h1>Notification Center</h1></div><form method="POST" action="/notifications/read-all"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small" type="submit">Tandai Semua Dibaca</button></form></div>
<div class="card-list"><% notifications.forEach(function(item) { %><article class="card <%= item.read_at ? 'notification-read' : '' %>"><div class="page-head"><div><span class="badge"><%= item.severity %></span><h3><%= item.title %></h3><p><%= item.message %></p><span class="hint"><%= formatDate(item.created_at) %></span></div><div><% if (item.link) { %><a class="btn small" href="<%= item.link %>">Buka</a><% } %><% if (!item.read_at) { %><form method="POST" action="/notifications/<%= item.id %>/read"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small" type="submit">Dibaca</button></form><% } %></div></div></article><% }); %><% if (!notifications.length) { %><div class="empty-state">Belum ada notifikasi.</div><% } %></div>
<%- include('partials/footer') %>
