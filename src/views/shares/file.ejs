<%- include('../partials/auth-header') %>
<section style="max-width:800px;margin:30px auto;padding:24px;background:var(--panel);border:1px solid var(--border);border-radius:12px;">
  <h1 style="overflow-wrap:anywhere;"><%= file.name %></h1>
  <p style="white-space:pre-wrap;overflow-wrap:anywhere;"><%= file.caption || '' %></p>
  <dl>
    <dt>Ukuran berkas</dt><dd><%= formatSize(file.size) %></dd>
    <dt>Tipe berkas</dt><dd><%= file.mime || 'application/octet-stream' %></dd>
    <dt>Diunggah</dt><dd><%= formatDate(file.created_at) %></dd>
  </dl>
  <button class="btn secondary" type="button" data-file-preview="/share/<%= uuid %>/preview" data-name="<%= file.name %>" data-caption="<%= file.caption || '' %>">Pratinjau berkas</button>
  <a class="btn" href="/share/<%= uuid %>/download">Unduh berkas asli</a>
</section>
<%- include('../partials/file-preview') %>
<%- include('../partials/footer') %>
