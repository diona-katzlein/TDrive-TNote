<%- include('partials/header') %>
<div class="page-head"><div><div class="breadcrumb">Operations / Health</div><h1>Storage & Telegram Health</h1><p class="hint">Kapasitas, pertumbuhan, antrean, upload, backup, rekonsiliasi, dan koneksi Telegram akun aktif.</p></div></div>
<div class="stats-grid"><div class="card"><span class="hint">Total Storage</span><h2><%= formatSize(health.totals.total_bytes) %></h2><% if (health.totals.quota_percent != null) { %><div><%= health.totals.quota_percent %>% dari quota</div><progress max="100" value="<%= Math.min(health.totals.quota_percent,100) %>"></progress><% } %></div><div class="card"><span class="hint">File</span><h2><%= health.totals.file_count %></h2></div><div class="card"><span class="hint">Chunk</span><h2><%= health.totals.chunk_count %></h2></div><div class="card"><span class="hint">Telegram</span><h2><%= health.telegram.status %></h2><span class="hint"><%= health.telegram.connected ? 'Connected' : 'Disconnected' %></span></div></div>
<div class="backup-grid"><div class="card"><h2>Pertumbuhan</h2><table><tr><td>24 jam</td><td><%= health.growth.daily_files %> file / <%= formatSize(health.growth.daily_bytes) %></td></tr><tr><td>30 hari</td><td><%= health.growth.monthly_files %> file / <%= formatSize(health.growth.monthly_bytes) %></td></tr></table></div><div class="card"><h2>Operational State</h2><p>Backup: <strong><%= health.backup ? health.backup.status : 'belum ada' %></strong></p><p>Rekonsiliasi: <strong><%= health.reconciliation ? health.reconciliation.status : 'belum ada' %></strong></p><p>Channel: <strong><%= health.channels.length %></strong></p></div></div>
<div class="backup-grid"><div class="card"><h2>Job Status</h2><% health.jobs.forEach(function(x){ %><div><span class="badge"><%= x.status %></span> <%= x.count %></div><% }); %><% if (!health.jobs.length) { %><span class="hint">Belum ada job.</span><% } %></div><div class="card"><h2>Upload Status</h2><% health.uploads.forEach(function(x){ %><div><span class="badge"><%= x.status %></span> <%= x.count %></div><% }); %><% if (!health.uploads.length) { %><span class="hint">Belum ada upload session tercatat.</span><% } %></div></div>
<div class="card"><h2>File Terbesar</h2><div class="table-wrap"><table><thead><tr><th>Nama</th><th>Ukuran</th><th>Aksi</th></tr></thead><tbody><% health.largest.forEach(function(file){ %><tr><td><%= file.name %></td><td><%= formatSize(file.size) %></td><td><a class="btn small" href="/drive/file/<%= file.uuid %>/download">Unduh</a></td></tr><% }); %></tbody></table></div></div>
<%- include('partials/footer') %>
