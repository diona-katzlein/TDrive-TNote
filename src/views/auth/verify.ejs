<%- include('../partials/auth-header') %>

<div class="auth-card card narrow">
  <h1><%= needPassword ? 'Password Cloud Telegram' : 'Verifikasi Login' %></h1>
  <p class="hint"><% if (needPassword) { %>Akun Telegram ini mengaktifkan password Cloud Telegram. Masukkan password tersebut untuk melanjutkan.<% } else { %>Kode OTP dikirim ke Telegram untuk nomor <strong><%= phone %></strong>.<% } %></p>

  <% if (error) { %><div class="alert <%= needPassword ? 'info' : 'error' %>"><%= error %></div><% } %>

  <form method="POST" action="/login/verify" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="phone" value="<%= phone %>" />
    <label>Kode OTP
      <input type="text" name="code" required inputmode="numeric" placeholder="12345" <%= needPassword ? '' : 'autofocus' %> />
    </label>
    <% if (needPassword) { %>
      <label>Password Cloud Telegram (wajib)
        <input type="password" name="password" required placeholder="Password Cloud Telegram" autofocus autocomplete="current-password" />
      </label>
    <% } %>
    <button class="btn" type="submit">Masuk</button>
  </form>
</div>

<%- include('../partials/footer') %>
