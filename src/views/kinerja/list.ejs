<%- include('../partials/header') %>

<style>
  .kinerja-head { display:flex; justify-content:space-between; align-items:center; gap:16px; margin-bottom:20px; }
  .kinerja-card { overflow-x:auto; }
  .kinerja-thumb { width:74px; height:58px; object-fit:cover; border-radius:8px; border:1px solid var(--border); }
  .kinerja-actions { display:flex; gap:7px; flex-wrap:wrap; }
  .share-box { margin-top:8px; padding:10px; border:1px solid var(--border); border-radius:8px; background:var(--panel-2); }
  .share-box input { width:100%; margin:4px 0; background:var(--bg); color:var(--text); border:1px solid var(--border); border-radius:6px; padding:7px; }
  .modal-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.75); z-index:1000; align-items:center; justify-content:center; padding:20px; }
  .modal-card { width:100%; max-width:480px; background:var(--panel); border:1px solid var(--border); border-radius:12px; padding:22px; }
  @media (max-width:700px) { .kinerja-head { align-items:flex-start; flex-direction:column; } }
</style>

<div class="kinerja-head">
  <div>
    <h1 style="margin:0;">📋 TKinerja</h1>
    <p class="hint" style="margin:5px 0 0;">Laporan bukti dukung kinerja yang tersusun otomatis per bulan dan tanggal.</p>
  </div>
  <a class="btn" href="/kinerja/new">+ Buat Laporan</a>
</div>

<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<% if (notice) { %><div class="alert info"><%= notice %></div><% } %>

<div class="card kinerja-card">
  <table class="grid">
    <thead><tr><th>Tanggal</th><th>Kegiatan</th><th>Waktu</th><th>Bukti</th><th>Aksi</th></tr></thead>
    <tbody>
      <% reports.forEach(function(r) { %>
        <tr>
          <td><strong><%= String(r.activity_date).slice(0, 10) %></strong></td>
          <td>
            <strong><%= r.title %></strong>
            <% if (r.description) { %><div class="hint"><%= r.description.length > 110 ? r.description.slice(0, 110) + '…' : r.description %></div><% } %>
          </td>
          <td><%= String(r.start_time).slice(0,5) %>–<%= String(r.end_time).slice(0,5) %></td>
          <td>
            <% if (r.evidence_uuid) { %><a href="/kinerja/<%= r.uuid %>/evidence" target="_blank"><img class="kinerja-thumb" src="/kinerja/<%= r.uuid %>/evidence" alt="Bukti <%= r.title %>"></a><% } else { %><span class="hint">Tanpa gambar</span><% } %>
          </td>
          <td>
            <div class="kinerja-actions">
              <a class="btn small ghost" href="/kinerja/<%= r.uuid %>/edit">Edit</a>
              <% if (!r.share_uuid) { %>
                <button class="btn small ghost" type="button" data-uuid="<%= r.uuid %>" data-title="<%= r.title %>" onclick="openShare(this.dataset.uuid, this.dataset.title)">🔗 Share</button>
              <% } %>
              <form method="POST" action="/kinerja/<%= r.uuid %>/delete" onsubmit="return confirm('Hapus laporan dan bukti gambarnya?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small danger">Hapus</button>
              </form>
            </div>
            <% if (r.share_uuid) { %>
              <div class="share-box">
                <small style="color:var(--ok);">● Share aktif</small>
                <input readonly value="<%= domain %>/s/<%= r.short_code %>" onclick="this.select()">
                <div class="kinerja-actions">
                  <button class="btn small" type="button" onclick="navigator.clipboard.writeText('<%= domain %>/s/<%= r.short_code %>')">Salin TShort</button>
                  <form method="POST" action="/share/<%= r.share_uuid %>/revoke">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="redirect" value="/kinerja">
                    <button class="btn small danger">Cabut</button>
                  </form>
                </div>
              </div>
            <% } %>
          </td>
        </tr>
      <% }); %>
      <% if (!reports.length) { %><tr><td colspan="5" class="empty-row">Belum ada laporan. Klik “Buat Laporan” untuk mulai.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div id="shareModal" class="modal-overlay">
  <div class="modal-card">
    <h3 style="margin-top:0;">Bagikan Laporan TKinerja</h3>
    <p class="hint">Laporan: <strong id="shareName"></strong></p>
    <form class="form" method="POST" action="/share/create">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="redirect" value="/kinerja">
      <input type="hidden" name="item_type" value="kinerja"><input type="hidden" name="item_uuid" id="shareUuid">
      <label>Password (opsional)<input type="password" name="password" placeholder="Kosongkan jika tanpa password"></label>
      <label>Masa berlaku
        <select name="expires_in_hours" style="padding:10px;background:var(--panel-2);color:var(--text);border:1px solid var(--border);border-radius:8px;">
          <option value="">No expired (selamanya)</option><option value="24">24 jam</option><option value="168">7 hari</option><option value="720">30 hari</option>
        </select>
      </label>
      <div class="form-actions"><button class="btn">Buat TShort</button><button class="btn ghost" type="button" onclick="closeShare()">Batal</button></div>
    </form>
  </div>
</div>
<script>
function openShare(uuid,name){document.getElementById('shareUuid').value=uuid;document.getElementById('shareName').textContent=name;document.getElementById('shareModal').style.display='flex';}
function closeShare(){document.getElementById('shareModal').style.display='none';}
</script>

<%- include('../partials/footer') %>
