<%- include('../partials/header') %>

<style>
  .evidence-drop { border:2px dashed var(--border); border-radius:12px; padding:20px; text-align:center; background:var(--panel-2); transition:.2s; }
  .evidence-drop.active { border-color:var(--accent); background:rgba(46,166,255,.08); }
  .evidence-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); gap:12px; margin-top:12px; }
  .evidence-item { position:relative; padding:8px; border:1px solid var(--border); border-radius:10px; background:var(--panel-2); }
  .evidence-item img { width:100%; height:120px; object-fit:cover; border-radius:7px; background:#000; }
  .evidence-item small { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; margin:5px 0; }
  .evidence-remove { width:100%; padding:5px; }
</style>

<% var formReturnUrl = report && typeof returnUrl !== 'undefined' ? returnUrl : '/kinerja'; %>
<div class="page-head">
  <div><h1><%= report ? 'Edit' : 'Buat' %> Laporan TKinerja</h1><p class="hint">Bukti akan tersusun otomatis ke Kinerja-{Bulan}/dd-mm-yyyy.</p></div>
  <a class="btn ghost" href="<%= formReturnUrl %>">← Kembali</a>
</div>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<% if (typeof notice !== 'undefined' && notice) { %><div class="alert info"><%= notice %></div><% } %>

<div class="card" style="max-width:820px;">
  <form id="kinerjaForm" class="form" method="POST" action="<%= report ? '/kinerja/' + report.uuid : '/kinerja' %>?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Tanggal kegiatan<input type="date" name="activity_date" value="<%= report ? String(report.activity_date).slice(0,10) : '' %>" required></label>
    <label>Judul kegiatan<input type="text" name="title" maxlength="255" value="<%= report ? report.title : '' %>" placeholder="Contoh: Rapat koordinasi bulanan" required></label>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
      <label>Jam mulai<input type="time" name="start_time" value="<%= report ? String(report.start_time).slice(0,5) : '' %>" required></label>
      <label>Jam selesai<input type="time" name="end_time" value="<%= report ? String(report.end_time).slice(0,5) : '' %>" required></label>
    </div>
    <label>Isi kegiatan (opsional)<textarea name="description" placeholder="Tuliskan ringkasan, hasil, atau detail kegiatan..."><%= report && report.description ? report.description : '' %></textarea></label>

    <div>
      <label>Bukti dukung (opsional, maksimum <%= maxEvidenceFiles %> berkas × <%= maxImageMb %> MB)</label>
      <div id="evidenceDrop" class="evidence-drop" tabindex="0" data-max-files="<%= maxEvidenceFiles %>" data-existing="<%= report && report.evidence ? report.evidence.length : 0 %>" data-max-mb="<%= maxImageMb %>">
        <strong>📎 Pilih atau seret gambar dan dokumen ke sini</strong>
        <p class="hint">Gambar, PDF, Excel (.xls, .xlsx), PowerPoint (.ppt, .pptx), Word (.doc, .docx). Ctrl+V untuk menambahkan screenshot. Pratinjau dokumen tersedia setelah disimpan.</p>
        <button class="btn ghost" type="button" onclick="document.getElementById('evidence').click()">Pilih Berkas</button>
        <input id="evidence" type="file" name="evidence" accept="image/*,.pdf,.xls,.xlsx,.ppt,.pptx,.doc,.docx" multiple hidden>
      </div>
      <div id="pendingEvidence" class="evidence-grid"></div>
      <p id="evidenceStatus" class="hint">Belum ada bukti baru dipilih.</p>
    </div>

    <% if (report && report.evidence && report.evidence.length) { %>
      <div><strong>Bukti tersimpan (<%= report.evidence.length %>):</strong>
        <div class="evidence-grid">
          <% report.evidence.forEach(function(item) { %>
            <div class="evidence-item">
              <a href="/kinerja/<%= report.uuid %>/evidence/<%= item.evidence_id %>?preview=1" target="_blank" rel="noopener">
                <% if ((item.mime || '').startsWith('image/')) { %><img src="/kinerja/<%= report.uuid %>/evidence/<%= item.evidence_id %>" alt="<%= item.name %>"><% } else { %><span style="display:block;padding:35px 8px;text-align:center;">📄 Pratinjau dokumen</span><% } %>
              </a>
              <small title="<%= item.name %>"><%= item.name %></small>
              <button class="btn small danger evidence-remove" type="submit" formnovalidate
                formaction="/kinerja/<%= report.uuid %>/evidence/<%= item.evidence_id %>/delete?_csrf=<%= encodeURIComponent(csrfToken) %>"
                formmethod="POST" onclick="return confirm('Hapus bukti ini?');">Hapus</button>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>

    <div class="alert info" style="margin:0;">📁 Folder dibuat otomatis berdasarkan tanggal: <strong>Kinerja-<span id="monthName">Bulan</span></strong> / <strong id="dateFolder">dd-mm-yyyy</strong>.</div>
    <div class="form-actions"><button class="btn"><%= report ? 'Simpan Perubahan' : 'Buat Laporan' %></button><a class="btn ghost" href="<%= formReturnUrl %>">Batal</a></div>
  </form>
</div>
<script>
(function(){
  var months=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
  var date=document.querySelector('[name="activity_date"]'),input=document.getElementById('evidence'),drop=document.getElementById('evidenceDrop'),grid=document.getElementById('pendingEvidence'),status=document.getElementById('evidenceStatus');
  var maxFiles=Number(drop.dataset.maxFiles),maxBytes=Number(drop.dataset.maxMb)*1024*1024,files=[];
  if(!date.value){var now=new Date();date.value=now.getFullYear()+'-'+String(now.getMonth()+1).padStart(2,'0')+'-'+String(now.getDate()).padStart(2,'0');}
  function updateFolder(){var p=date.value.split('-');if(p.length===3){document.getElementById('monthName').textContent=months[Number(p[1])-1];document.getElementById('dateFolder').textContent=p[2]+'-'+p[1]+'-'+p[0];}}
  function signature(file){return [file.name,file.size,file.lastModified].join(':');}
  function sync(){var transfer=new DataTransfer();files.forEach(function(file){transfer.items.add(file);});input.files=transfer.files;render();}
  var previewUrls=[];
  function render(){
    previewUrls.forEach(function(url){URL.revokeObjectURL(url);});previewUrls=[];grid.innerHTML='';
    files.forEach(function(file,index){
      var card=document.createElement('div');card.className='evidence-item';
      if(file.type.startsWith('image/')){var img=document.createElement('img'),url=URL.createObjectURL(file);previewUrls.push(url);img.src=url;img.alt=file.name;card.appendChild(img);}
      else {var documentLabel=document.createElement('div');documentLabel.textContent='📄 '+file.name.split('.').pop().toUpperCase();documentLabel.style.padding='35px 8px';card.appendChild(documentLabel);}
      var name=document.createElement('small');name.textContent=file.name;name.title=file.name;
      var remove=document.createElement('button');remove.type='button';remove.className='btn small danger evidence-remove';remove.textContent='Hapus';remove.onclick=function(){files.splice(index,1);sync();};card.append(name,remove);grid.appendChild(card);
    });
    status.textContent=files.length?files.length+' bukti baru siap diunggah. Klik Hapus jika belum sesuai.':'Belum ada bukti baru dipilih.';
  }
  function add(incoming){var errors=[];Array.from(incoming||[]).forEach(function(file){if(!file.type.startsWith('image/')&&!/\.(pdf|xlsx?|pptx?|docx?)$/i.test(file.name))errors.push(file.name+' bukan jenis bukti yang didukung.');else if(file.size>maxBytes)errors.push(file.name+' melebihi batas ukuran.');else if(files.some(function(current){return signature(current)===signature(file);}))return;else if(files.length+Number(drop.dataset.existing)>=maxFiles)errors.push('Maksimum '+maxFiles+' berkas termasuk bukti tersimpan.');else files.push(file);});sync();if(errors.length)alert(errors.join('\n'));}
  window.addEventListener('pagehide',function(){previewUrls.forEach(function(url){URL.revokeObjectURL(url);});});
  input.addEventListener('change',function(){add(this.files);});
  document.addEventListener('paste',function(event){var pasted=Array.from(event.clipboardData&&event.clipboardData.files||[]).filter(function(file){return file.type.startsWith('image/');});if(pasted.length){event.preventDefault();pasted.forEach(function(file,index){if(!file.name||file.name==='image.png')Object.defineProperty(file,'name',{value:'Screenshot-'+Date.now()+'-'+(index+1)+'.png'});});add(pasted);}});
  ['dragenter','dragover'].forEach(function(type){drop.addEventListener(type,function(event){event.preventDefault();drop.classList.add('active');});});
  ['dragleave','drop'].forEach(function(type){drop.addEventListener(type,function(event){event.preventDefault();drop.classList.remove('active');});});
  drop.addEventListener('drop',function(event){add(event.dataTransfer.files);});
  date.addEventListener('change',updateFolder);updateFolder();render();
})();
</script>

<%- include('../partials/footer') %>
